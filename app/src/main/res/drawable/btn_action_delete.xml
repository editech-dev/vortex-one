<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#7FDC2626" />
            <stroke android:width="2dp" android:color="#F87171" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#99DC2626" />
            <stroke android:width="1.5dp" android:color="#EF4444" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#26DC2626" />
            <stroke android:width="1dp" android:color="#B91C1C" />
        </shape>
    </item>
</selector>
