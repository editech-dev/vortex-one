<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: High contrast Indigo Glow + White/Indigo Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#818CF8"
                android:startColor="#6366F1" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#4338CA"
                android:startColor="#312E81" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default State: Sleek Dark Slate Pill with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#334155"
                android:startColor="#1E293B" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#475569" />
        </shape>
    </item>
</selector>
