<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#7F4F46E5" />
            <stroke android:width="2dp" android:color="#818CF8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#994F46E5" />
            <stroke android:width="1.5dp" android:color="#6366F1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#334F46E5" />
            <stroke android:width="1dp" android:color="#4F46E5" />
        </shape>
    </item>
</selector>
