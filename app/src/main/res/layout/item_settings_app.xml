<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    android:focusable="false"
    android:clickable="false"
    android:descendantFocusability="afterDescendants"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <!-- Single Horizontal Row: Icon + Info + Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:descendantFocusability="afterDescendants"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- App Icon in Compact Frame (42dp) -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_splash_icon_card"
            android:padding="5dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apps_grid"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- App Info & Storage Badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="WhatsApp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="com.whatsapp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#475569"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvStorageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Caché: 1.2 MB | Datos: 15.4 MB" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Side-by-Side on the Right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:descendantFocusability="afterDescendants">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/action_clear_cache"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:focusable="true"
                android:clickable="true"
                android:stateListAnimator="@animator/scaler"
                android:nextFocusRight="@id/btnClearData"
                app:backgroundTint="@color/btn_bg_cache"
                app:strokeColor="@color/btn_stroke_cache"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_clean"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#38BDF8"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearData"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/action_clear_data"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FDE68A"
                android:focusable="true"
                android:clickable="true"
                android:stateListAnimator="@animator/scaler"
                android:nextFocusLeft="@id/btnClearCache"
                app:backgroundTint="@color/btn_bg_data"
                app:strokeColor="@color/btn_stroke_data"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_restore"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#FBBF24" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
