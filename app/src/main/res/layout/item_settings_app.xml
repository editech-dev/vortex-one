<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:focusable="false"
    android:clickable="false"
    android:descendantFocusability="afterDescendants"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:descendantFocusability="afterDescendants"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- App Icon Frame (48dp) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_splash_icon_card"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apps_grid"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- App Info (Vertical Stack: Name -> Package -> Storage Chip) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="WhatsApp" />

            <TextView
                android:id="@+id/tvPackageName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="com.whatsapp" />

            <!-- Storage Info Pill -->
            <TextView
                android:id="@+id/tvStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_state_badge"
                android:layout_marginTop="4dp"
                tools:text="Caché: 1.2 MB  ·  Datos: 15.4 MB" />
        </LinearLayout>

        <!-- Action Buttons on the Right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:descendantFocusability="afterDescendants">

            <!-- Botón Limpiar Caché -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/action_clear_cache"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:singleLine="true"
                android:maxLines="1"
                android:focusable="true"
                android:clickable="true"
                android:stateListAnimator="@animator/scaler"
                android:nextFocusRight="@id/btnClearData"
                app:backgroundTint="@color/btn_bg_cache"
                app:strokeColor="@color/btn_stroke_cache"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_clean"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#38BDF8"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <!-- Botón Borrar Datos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearData"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/action_clear_data"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FDE68A"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:singleLine="true"
                android:maxLines="1"
                android:focusable="true"
                android:clickable="true"
                android:stateListAnimator="@animator/scaler"
                android:nextFocusLeft="@id/btnClearCache"
                app:backgroundTint="@color/btn_bg_data"
                app:strokeColor="@color/btn_stroke_data"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_restore"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#FBBF24"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
