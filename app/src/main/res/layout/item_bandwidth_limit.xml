<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:stateListAnimator="@animator/scaler"
    android:descendantFocusability="blocksDescendants"
    android:foreground="@drawable/selector_item_virtual_app"
    app:cardBackgroundColor="@color/card_bg_selector"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/card_stroke_selector"
    app:strokeWidth="1.5dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="Límite de Subida" />

            <!-- Speed Value Highlight -->
            <TextView
                android:id="@+id/tvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_state_badge"
                tools:text="Ilimitado" />
        </LinearLayout>

        <!-- SeekBar: Visual display driven by Card D-pad left/right -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="8"
            android:progress="0"
            android:thumbTint="#38BDF8"
            android:progressTint="#818CF8"
            android:progressBackgroundTint="#334155"
            android:focusable="false"
            android:clickable="false"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            tools:text="Ajusta la velocidad con ◀ / ▶ del control remoto" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
