<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:paddingStart="52dp"
    android:paddingEnd="52dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutButtons"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackHeader"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="@string/action_close"
            android:focusable="true"
            android:nextFocusRight="@id/btnRescan"
            android:nextFocusDown="@id/etSearch" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_install_apk"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Estado del escaneo -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Buscando archivos APK..."
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de acción superiores -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/headerContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescan"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:text="Reescanear"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:stateListAnimator="@animator/scaler"
            android:background="@drawable/btn_gradient_secondary"
            app:backgroundTint="@null"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_restore"
            app:iconGravity="textStart"
            app:iconTint="#38BDF8"
            android:nextFocusLeft="@id/btnBackHeader"
            android:nextFocusRight="@id/btnCancel"
            android:nextFocusDown="@id/etSearch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/action_cancel"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:stateListAnimator="@animator/scaler"
            android:background="?attr/selectableItemBackground"
            app:backgroundTint="@null"
            app:cornerRadius="8dp"
            android:nextFocusLeft="@id/btnRescan"
            android:nextFocusDown="@id/etSearch" />
    </LinearLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_input"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:hint="@string/hint_search_apps"
        android:textColorHint="#80FFFFFF"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:nextFocusUp="@id/btnRescan"
        android:nextFocusDown="@id/rvApkFiles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer" />

    <!-- Lista de APKs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApkFiles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSearch" />

    <!-- Banner Ad Container -->
    <RelativeLayout
        android:id="@+id/bannerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSearch">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.4"
            android:src="@drawable/ic_apps_grid"
            app:tint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/status_no_apks_found"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/accent_color"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
