<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="52dp"
    android:paddingEnd="52dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp"
    tools:context=".activities.SettingsActivity">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="@string/action_close"
            android:nextFocusDown="@id/btnClearAllCache"
            android:nextFocusRight="@id/rvSettingsApps" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <!-- Badge 2.0 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/tv_edition_tag"
                    android:textColor="#818CF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_state_badge" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_subtitle"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Two-Panel 16:9 Master-Detail Layout -->
    <LinearLayout
        android:id="@+id/mainPanelsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left Master Panel (32% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="32"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <!-- Card de Resumen y Acciones Globales -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGlobalActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_overview_title"
                        android:textColor="#F1F5F9"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optimización y mantenimiento del almacenamiento interno del sandbox."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <!-- Botón Limpiar Caché Global Elegante y 100% Legible -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearAllCache"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/btn_clear_all_cache"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="12dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:stateListAnimator="@animator/scaler"
                        app:backgroundTint="@color/btn_bg_cache"
                        app:strokeColor="@color/btn_stroke_cache"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_clean"
                        app:iconSize="15dp"
                        app:iconPadding="6dp"
                        app:iconGravity="textStart"
                        app:iconTint="#38BDF8"
                        android:nextFocusUp="@id/btnBack"
                        android:nextFocusDown="@id/btnToggleGms"
                        android:nextFocusRight="@id/rvSettingsApps" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Servicios de Google (GMS) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGmsServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gms_settings_title"
                            android:textColor="#F1F5F9"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvGmsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gms_status_not_installed"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:background="@drawable/bg_state_badge" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gms_settings_desc"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleGms"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_install_gms"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:stateListAnimator="@animator/scaler"
                        app:backgroundTint="#0284C7"
                        app:strokeColor="#38BDF8"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_google"
                        app:iconSize="14dp"
                        app:iconPadding="6dp"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF"
                        android:nextFocusUp="@id/btnClearAllCache"
                        android:nextFocusDown="@id/btnCheckUpdates"
                        android:nextFocusRight="@id/rvSettingsApps" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Información del Sistema & Versión -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VORTEX ONE 2.0"
                        android:textColor="#818CF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVersionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        tools:text="Versión 2.0.0 (Build 200) • Hecho con ❤️ por editech-dev" />

                    <!-- Botón Buscar Actualizaciones -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdates"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/btn_check_updates"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#E2E8F0"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:stateListAnimator="@animator/scaler"
                        app:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_restore"
                        app:iconSize="14dp"
                        app:iconPadding="6dp"
                        app:iconGravity="textStart"
                        app:iconTint="#38BDF8"
                        android:nextFocusUp="@id/btnToggleGms"
                        android:nextFocusRight="@id/rvSettingsApps" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Right Detail Panel: Apps List (68% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="68"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_apps_list_title"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSettingsApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="2dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:focusable="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusLeft="@id/btnClearAllCache"
                tools:listitem="@layout/item_settings_app" />
        </LinearLayout>

    </LinearLayout>

    <!-- Banner Ad Container -->
    <RelativeLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bannerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.4"
            android:src="@drawable/ic_apps_grid"
            app:tint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/empty_state_title"
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/empty_state_desc"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/accent_color"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
