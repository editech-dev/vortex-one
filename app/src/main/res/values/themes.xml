<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme - MaterialComponents required for MaterialCardView -->
    <style name="Theme.VortexTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_color</item>
        <item name="colorPrimaryVariant">@color/accent_focus</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Windows and Status -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@drawable/bg_main</item>

        <!-- Button style defaults (No forced uppercase, natural letter spacing) -->
        <item name="materialButtonStyle">@style/Widget.Vortex.Button</item>
    </style>

    <style name="Widget.Vortex.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Vortex.TabItem" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>